# Image with the helper processes of the web console: the backup worker, the cluster agent, and the access policy worker.
# The first argument chooses the process (see tools-entrypoint.sh); configuration is in environment variables, as for
# the scripts themselves (see README.md).
#
# Built by package_images.sh from a staging directory that holds the scripts, `console.html` (the access policy worker
# loads its policy model from it), `tools-entrypoint.sh`, and `VERSION`.
ARG NODE_IMAGE=node:22.22.0-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker:28.5.2-cli

# The docker CLI and its Compose plugin, for the docker-compose provider of the cluster agent (static binaries).
FROM ${DOCKER_CLI_IMAGE} AS docker-cli

# kubectl, for the kubernetes provider of the cluster agent, checked against the published checksum.
FROM debian:bookworm-20251020-slim AS kubectl
ARG KUBECTL_VERSION=v1.31.5
ARG KUBECTL_SHA256=fbecbfd375b3686002c2e81d51c390172f5ffba3d6b47920d55342cb03f557af
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && echo "${KUBECTL_SHA256}  /kubectl" | sha256sum -c - \
    && chmod 0555 /kubectl

FROM ${NODE_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="ClickHouse web console tools" \
      org.opencontainers.image.description="Backup worker, cluster agent, and access policy worker of the ClickHouse web console" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=kubectl /kubectl /usr/local/bin/kubectl

COPY --chmod=0555 backup_worker.mjs cluster_agent.mjs access_policy_worker.mjs console.html VERSION /opt/clickhouse-console/
COPY --chmod=0555 tools-entrypoint.sh /usr/local/bin/clickhouse-console-tools

# The cluster agent keeps its key pair and the generated deployments here; mount a volume to keep them.
RUN mkdir -p /var/lib/clickhouse-console && chown node:node /var/lib/clickhouse-console
ENV CONSOLE_HTML=/opt/clickhouse-console/console.html \
    CLUSTER_AGENT_STATE_DIR=/var/lib/clickhouse-console/clusters

USER node
WORKDIR /opt/clickhouse-console
ENTRYPOINT ["clickhouse-console-tools"]
CMD ["help"]
