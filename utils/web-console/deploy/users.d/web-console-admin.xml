<!-- The first administrator of the console, the user `default` (its password and `access_management` come from the
     image's environment variables). `named_collection_control` lets it create named collections and grant them, which
     the Backup Administrator role template and the S3 destinations of Backup & Restore need. -->
<clickhouse>
    <users>
        <default>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>
