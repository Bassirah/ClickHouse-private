# Settings of one environment. Copy to `.env` (readable by its owner only: chmod 600 .env) and fill in.

# The version of the images, as loaded with `docker load` (see MANIFEST.txt).
CONSOLE_VERSION=VERSION

# Address and ports the server publishes on the host. 127.0.0.1 keeps it local; use the host's address, or 0.0.0.0,
# only behind a firewall or a TLS-terminating proxy: the console sends passwords over HTTP otherwise.
CONSOLE_BIND=127.0.0.1
CONSOLE_HTTP_PORT=8123
CONSOLE_NATIVE_PORT=9000

# Password of the `default` user, the first administrator (with access management).
CLICKHOUSE_ADMIN_PASSWORD=

# Passwords of the service accounts of the helper processes (see service-accounts.sql).
BACKUP_WORKER_PASSWORD=
ACCESS_POLICY_WORKER_PASSWORD=
CLUSTER_AGENT_PASSWORD=

# Access policy worker: interval, and an optional attribute feed (a file in the container, or an https:// URL).
ACCESS_POLICY_INTERVAL_SECONDS=60
ATTRIBUTE_FEED=
ATTRIBUTE_FEED_SOURCE=feed
ATTRIBUTE_FEED_TOKEN=

# Cluster agent (compose.cluster-agent.yaml). DOCKER_GID: `stat -c %g /var/run/docker.sock`. The state directory is an
# absolute path on the host, owned by CLUSTER_AGENT_UID. CLUSTER_AGENT_KUBECONFIG, a path on the host, enables the
# kubernetes provider.
DOCKER_GID=
CLUSTER_AGENT_UID=1000
CLUSTER_AGENT_STATE_DIR=/var/lib/clickhouse-console/clusters
CLUSTER_AGENT_ENVIRONMENTS=lab,development
CLUSTER_AGENT_KUBECONFIG=
CLUSTER_AGENT_K8S_NAMESPACES=chc-*

# Server bundles (compose.bundles.yaml): file, vault, or passphrase.
BUNDLE_KEY_PROVIDER=file
VAULT_ADDR=
VAULT_TRANSIT_KEY=
# A destination of Backup & Restore for automatic bundles, and their interval in hours (0: only on request).
BUNDLE_DESTINATION=
BUNDLE_EVERY_HOURS=0
