<clickhouse>
    <http_handlers>
        <rule>
            <url>regex:^/console(/.*)?$</url>
            <methods>GET,HEAD</methods>
            <handler>
                <type>console</type>
                <http_response_headers>
                    <X-Frame-Options>SAMEORIGIN</X-Frame-Options>
                    <X-Test-Console>yes</X-Test-Console>
                </http_response_headers>
            </handler>
        </rule>
        <rule>
            <url>regex:^/ui(/.*)?$</url>
            <methods>GET,HEAD</methods>
            <handler>
                <type>sql_console</type>
                <!-- Does not apply: each file of the SQL Console keeps its own type. -->
                <content_type>text/plain</content_type>
                <http_response_headers>
                    <X-Frame-Options>DENY</X-Frame-Options>
                </http_response_headers>
            </handler>
        </rule>
        <defaults/>
    </http_handlers>
</clickhouse>
