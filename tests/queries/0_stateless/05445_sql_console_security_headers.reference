--- /ui
text/html
X-Frame-Options: SAMEORIGIN
X-Content-Type-Options: nosniff
Referrer-Policy: no-referrer
default-src 'none'
script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'
worker-src 'self' blob:
frame-ancestors 'self'
