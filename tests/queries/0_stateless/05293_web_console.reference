--- every path under /console serves the page (client-side routing)
/console 200 1
/console/ 200 1
/console/login 200 1
/console/sql 200 1
/console/merges 200 1
/console/login?next=merges 200 1
/console/unknown 200 1
/console/admin-users/alice 200 1
HEAD 200
--- sibling paths are not taken over
/consolex 4xx 0
--- the page is not cached, not framed by other sites, and loads nothing external
Cache-Control: no-store
X-Frame-Options: DENY
X-Content-Type-Options: nosniff
Referrer-Policy: no-referrer
frame-ancestors 'none'
script-src 'unsafe-inline';
0
--- destinations come from the server configuration, with defaults
Content-Type: application/json; charset=UTF-8
admin_database console_admin
backup_s3_endpoints (empty)
clickstack_url /clickstack/
cloud_url https://clickhouse.cloud/
documentation_url https://clickhouse.com/docs/
source_code_url https://github.com/ClickHouse/ClickHouse/
sql_console_clear_on_sign_out results
sso_client_id (empty)
sso_issuer (empty)
sso_name Keycloak
sso_scopes openid profile email
sso_username_claim preferred_username
website_url https://clickhouse.com/
--- the embedded pages implement the integration contract of the console
/play 1
/dashboard 1
/binary 1
/merges 1
/schema 1
/jemalloc 1
/processors-profile 1
/docs 1
